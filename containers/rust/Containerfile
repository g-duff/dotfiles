FROM rust:1.82-slim

RUN apt-get update && apt-get install -y \
    neovim \
    git \
    ripgrep \
    fd-find \
    build-essential \
    musl-tools \
    pkg-config \
    curl \
    unzip \
    && rm -rf /var/lib/apt/lists/*

RUN rustup target add aarch64-unknown-linux-musl
RUN rustup component add rust-analyzer rust-src

WORKDIR /workspace
